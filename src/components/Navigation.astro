---
/**
 * Navigation.astro - lab navigation
 *
 * Pages in this lab are named, not numbered, so prev/next are passed in
 * explicitly rather than calculated from a station number.
 */

interface Props {
  position: 'top' | 'bottom';
  positionLabel?: string;
  prevPage?: { url: string; label: string };
  nextPage?: { url: string; label: string };
  hubUrl?: string;
}

const { position, positionLabel, prevPage, nextPage, hubUrl = '/' } = Astro.props;

const isTopNav = position === 'top';
const ariaLabel = isTopNav ? 'Page navigation' : 'Previous and next page';
const navClass = isTopNav ? 'page-navigation top-nav' : 'page-navigation bottom-nav';
---

<nav aria-label={ariaLabel} class={navClass}>
    <a href={hubUrl} class="nav-link hub-link">
        {isTopNav ? 'Back to the lab index' : 'Lab index'}
    </a>

    {positionLabel && isTopNav && (
        <div class="page-position">{positionLabel}</div>
    )}

    {prevPage && !isTopNav && (
        <a href={prevPage.url} class="nav-link prev-link">
            &larr; {prevPage.label}
        </a>
    )}

    {nextPage && !isTopNav && (
        <a href={nextPage.url} class="nav-link next-link">
            Next: {nextPage.label} &rarr;
        </a>
    )}
</nav>
